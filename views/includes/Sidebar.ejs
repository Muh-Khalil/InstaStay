<!-- Sidebar -->
<div id="sidebar" class="sidebar bg-dark text-white vh-100">
    <div class="d-flex justify-content-between align-items-center p-4">
        <h3 class="text-center flex-grow-1" style="font-family: var(--serif); color: var(--gold);">Management</h3>
        <button id="close-sidebar" class="btn btn-outline-light btn-sm d-md-none"><i class="fas fa-times"></i></button>
    </div>
    
    <div class="px-3 mb-4 text-center">
        <div class="p-3 rounded" style="background: rgba(255,255,255,0.05); border: 1px solid rgba(255,255,255,0.05);">
            <div class="fs-4 text-gold mb-1"><i class="fas fa-user-shield"></i></div>
            <span class="fw-bold"><%= currUser ? currUser.username : 'Admin' %></span>
        </div>
    </div>

    <div class="menu-sections px-2">
        <a href="/admin" class="menu-link <%= req.path === '/admin' ? 'active' : '' %>">
            <i class="fas fa-chart-pie"></i> <span>Overview</span>
        </a>
        <a href="/admin/user" class="menu-link <%= req.path === '/admin/user' ? 'active' : '' %>">
            <i class="fas fa-users-cog"></i> <span>User Control</span>
        </a>
        <a href="/admin/listing" class="menu-link <%= req.path === '/admin/listing' ? 'active' : '' %>">
            <i class="fas fa-hotel"></i> <span>Hotel Audit</span>
        </a>
        <a href="/admin/booking" class="menu-link <%= req.path === '/admin/booking' ? 'active' : '' %>">
            <i class="fas fa-file-invoice-dollar"></i> <span>Reservations</span>
        </a>
        <a href="/admin/review" class="menu-link <%= req.path === '/admin/review' ? 'active' : '' %>">
            <i class="fas fa-comment-dots"></i> <span>Reviews</span>
        </a>
        <div class="border-top border-secondary border-opacity-25 my-3 mx-3"></div>
        <a href="/admin/analytics" class="menu-link <%= req.path === '/admin/analytics' ? 'active' : '' %>">
            <i class="fas fa-microchip"></i> <span>System Health</span>
        </a>
        <a href="/admin/setting" class="menu-link <%= req.path === '/admin/setting' ? 'active' : '' %>">
            <i class="fas fa-sliders-h"></i> <span>Site Config</span>
        </a>
    </div>

    <div class="mt-auto p-4">
        <a href="/" class="btn btn-outline-gold w-100 btn-sm mb-2"><i class="fas fa-eye"></i> View Site</a>
        <a href="/logout" class="btn btn-danger w-100 btn-sm py-2" style="background: #e74c3c; border: none;"><i class="fas fa-power-off"></i> Logout</a>
    </div>
</div>
