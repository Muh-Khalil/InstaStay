<% layout("/layout/boilerplate") %>

  <div class="auth-wrap">
    <div class="auth-card">
      <div class="auth-form-side">
        <div class="auth-header">
          <h2>Welcome Back</h2>
          <p>Enter your details below to access your account reservations, bookings, and privileges.</p>
        </div>

        <form action="/Login" method="post" class="auth-form needs-validation" novalidate>
          <div class="form-group">
            <label for="email">Email Address</label>
            <input type="email" name="email" id="email" placeholder="example@domain.com" required>
          </div>

          <div class="form-group">
            <label for="password">Password</label>
            <input type="password" name="password" id="password" placeholder="••••••••" required>
          </div>

          <button class="auth-btn">Sign In to Account</button>
        </form>

        <div class="auth-footer">
          <span>Don't have an account?</span>
          <a href="/signup">Create One</a>
        </div>
      </div>

      <div class="auth-img-side"
        style="background-image: url('https://images.unsplash.com/photo-1542314831-068cd1dbfeeb?w=1000&q=80');">
        <div class="auth-img-overlay">
          <h3>InstaStay Membership</h3>
          <p>Unlock exclusive member rates, early access to new properties, and complimentary upgrades during your stay.
          </p>
        </div>
      </div>
    </div>
  </div>