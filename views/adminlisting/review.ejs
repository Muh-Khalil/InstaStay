<% layout("/layout/admin-dashboard.ejs")%>

<div class="dashboard-header mb-5">
    <div class="row align-items-center">
        <div class="col">
            <h1 style="font-family: var(--serif); font-weight: 700; font-size: 32px;" class="mb-1 text-white">Guest Feedback Audit</h1>
            <p class="text-white-50 mb-0">Monitor platform sentiment and manage guest reviews.</p>
        </div>
        <div class="col-auto">
            <div class="stat-pill">
                <span class="text-white-50 small me-2">Global Sentiment:</span>
                <span class="text-warning fw-bold"><i class="fas fa-star me-1"></i> 4.8 Avg</span>
            </div>
        </div>
    </div>
</div>

<div class="table-premium table-responsive">
    <table class="table table-dark table-hover mb-0">
        <thead>
            <tr>
                <th class="ps-4">No.</th>
                <th>Author</th>
                <th>Rating</th>
                <th>Comment Content</th>
                <th class="text-end pe-4">Compliance</th>
            </tr>
        </thead>
        <tbody>
            <% reviews.forEach((review, index)=> { %>
                <tr>
                    <td class="ps-4 text-white-50 small">#<%= index+1 %></td>
                    <td>
                        <div class="fw-bold text-white small"><%= review.Author ? review.Author.username : 'Anonymous' %></div>
                        <div style="font-size: 11px;" class="text-white-50">Verified Booker</div>
                    </td>
                    <td>
                        <div class="d-flex text-warning gap-1">
                            <% for (let i=0; i < review.rating; i++) { %>
                                <i class="fas fa-star small"></i>
                            <% } %>
                            <% for (let i=review.rating; i < 5; i++) { %>
                                <i class="far fa-star small text-white-50 opacity-25"></i>
                            <% } %>
                        </div>
                    </td>
                    <td>
                        <p class="mb-0 text-white small" style="max-width: 400px; line-height: 1.6;"><%= review.comment %></p>
                    </td>
                    <td class="text-end pe-4">
                        <form action="/admin/review/<%= review._id %>/delete" method="POST" class="d-inline">
                            <button type="submit" class="btn btn-outline-danger btn-sm" onclick="return confirm('Delete this review? This action is permanent.')">
                                <i class="fas fa-trash-alt me-2"></i> Remove
                            </button>
                        </form>
                    </td>
                </tr>
            <% }); %>
            <% if (reviews.length === 0) { %>
                <tr>
                    <td colspan="5" class="py-5 text-center text-white-50 italic">No reviews found in the system.</td>
                </tr>
            <% } %>
        </tbody>
    </table>
</div>

<style>
    .stat-pill {
        background: rgba(255,255,255,0.03);
        border: 1px solid rgba(255,255,255,0.07);
        padding: 8px 25px;
        border-radius: 50px;
    }
    .btn-outline-danger {
         font-size: 11px;
         font-weight: 600;
         text-transform: uppercase;
         letter-spacing: 0.5px;
         color: #e74c3c;
         border-color: rgba(231, 76, 60, 0.2);
    }
    .btn-outline-danger:hover {
        background: #e74c3c;
        border-color: #e74c3c;
        color: white;
    }
</style>