<% layout("/layout/admin-dashboard.ejs") %>

<div class="dashboard-header mb-5">
    <div class="row align-items-center">
        <div class="col">
            <h1 style="font-family: var(--serif); font-weight: 700; font-size: 32px;" class="mb-1 text-white">System Intelligence</h1>
            <p class="text-white-50 mb-0">Platform performance audit and financial metrics overview.</p>
        </div>
        <div class="col-auto">
             <div class="stat-pill">
                <span class="text-gold fw-bold text-uppercase letter-spacing-1 small">Live Feed</span>
             </div>
        </div>
    </div>
</div>

<div class="row g-4 mb-5">
    <!-- Financial Volume -->
    <div class="col-md-3">
        <div class="stat-card border-bottom border-success border-3">
            <div class="icon-box text-success"><i class="fas fa-coins"></i></div>
            <h3 class="fs-6 text-white-50 mb-1 text-uppercase letter-spacing-1">Financial Volume</h3>
            <p class="fs-2 fw-bold mb-0 text-white" style="font-family: var(--serif);">$<%= totalRevenue.toLocaleString() %></p>
            <div class="mt-2 small text-success"><i class="fas fa-arrow-up"></i> Gross Revenue</div>
        </div>
    </div>
    <!-- Booking Velocity -->
    <div class="col-md-3">
        <div class="stat-card border-bottom border-primary border-3">
            <div class="icon-box text-primary"><i class="fas fa-bolt"></i></div>
            <h3 class="fs-6 text-white-50 mb-1 text-uppercase letter-spacing-1">Booking Velocity</h3>
            <p class="fs-2 fw-bold mb-0 text-white" style="font-family: var(--serif);"><%= bookings.length %></p>
            <div class="mt-2 small text-primary">Successful Transactions</div>
        </div>
    </div>
    <!-- Conversion Base -->
    <div class="col-md-3">
        <div class="stat-card border-bottom border-info border-3">
            <div class="icon-box text-info"><i class="fas fa-user-circle"></i></div>
            <h3 class="fs-6 text-white-50 mb-1 text-uppercase letter-spacing-1">Conversion Base</h3>
            <p class="fs-2 fw-bold mb-0 text-white" style="font-family: var(--serif);"><%= users.length %></p>
            <div class="mt-2 small text-info">Registered Accounts</div>
        </div>
    </div>
    <!-- Asset Density -->
    <div class="col-md-3">
        <div class="stat-card border-bottom border-warning border-3">
            <div class="icon-box text-warning"><i class="fas fa-layer-group"></i></div>
            <h3 class="fs-6 text-white-50 mb-1 text-uppercase letter-spacing-1">Asset Density</h3>
            <p class="fs-2 fw-bold mb-0 text-white" style="font-family: var(--serif);"><%= listings.length %></p>
            <div class="mt-2 small text-warning">Verified Hotel Units</div>
        </div>
    </div>
</div>

<h2 style="font-family: var(--serif); font-size: 24px;" class="mb-4 text-white">Transaction Audit Log</h2>
<div class="table-premium table-responsive">
    <table class="table table-dark table-hover mb-0">
        <thead>
            <tr>
                <th class="ps-4">Sequence</th>
                <th>Participant</th>
                <th>Asset Identity</th>
                <th class="text-end pe-4">Credit Value</th>
            </tr>
        </thead>
        <tbody>
            <% bookings.slice().reverse().forEach((booking, index)=> { %>
                <tr>
                    <td class="ps-4 text-white-50 small">#<%= bookings.length - index %></td>
                    <td>
                        <div class="fw-bold text-white small"><%= booking.user ? booking.user.username : 'Ex-User' %></div>
                        <div style="font-size: 11px;" class="text-white-50"><%= booking.user ? booking.user.email : 'N/A' %></div>
                    </td>
                    <td>
                        <div class="text-white small"><%= booking.listing ? booking.listing.title : 'Deleted Hotel' %></div>
                    </td>
                    <td class="text-end pe-4">
                        <span class="text-gold fw-bold">$<%= booking.listing ? booking.listing.price : 0 %></span>
                    </td>
                </tr>
            <% }) %>
            <% if (bookings.length === 0) { %>
                <tr>
                    <td colspan="4" class="py-5 text-center text-white-50 italic">No transaction records available.</td>
                </tr>
            <% } %>
        </tbody>
    </table>
</div>

<style>
    .stat-pill {
        background: rgba(255,255,255,0.03);
        border: 1px solid rgba(255,255,255,0.07);
        padding: 8px 25px;
        border-radius: 50px;
    }
</style>