<% layout("/layout/admin-dashboard.ejs") %>

<div class="dashboard-header mb-5">
    <div class="row align-items-center">
        <div class="col">
            <h1 style="font-family: var(--serif); font-weight: 700; font-size: 32px;" class="mb-1 text-white">Full Reservation Registry</h1>
            <p class="text-white-50 mb-0">System-wide monitoring of guest bookings and financial flow.</p>
        </div>
        <div class="col-auto d-none d-md-block">
            <div class="stat-pill">
                <span class="text-gold fw-bold"><%= bookings.length %> Verified Bookings</span>
            </div>
        </div>
    </div>
</div>

<div class="table-premium table-responsive">
    <table class="table table-dark table-hover mb-0">
        <thead>
            <tr>
                <th class="ps-4">No.</th>
                <th>Client</th>
                <th>Hotel</th>
                <th>Stay Period</th>
                <th>Revenue</th>
                <th class="text-end pe-4">Controls</th>
            </tr>
        </thead>
        <tbody>
            <% bookings.forEach((booking, index)=> { %>
                <tr>
                    <td class="ps-4 text-white-50 small">#<%= index + 1 %></td>
                    <td>
                        <div class="fw-bold text-white small"><%= booking.user ? booking.user.username : 'Ex-User' %></div>
                        <div style="font-size: 11px;" class="text-white-50"><%= booking.user ? booking.user.email : 'N/A' %></div>
                    </td>
                    <td>
                        <div class="text-white small fw-bold"><%= booking.listing ? booking.listing.title : 'Deleted Hotel' %></div>
                        <div class="text-gold" style="font-size: 11px;"><i class="fas fa-bed me-1"></i><%= booking.roomType %></div>
                    </td>
                    <td>
                        <div class="small text-white">
                            <%= new Date(booking.checkin).toLocaleDateString("en-US", {month: 'short', day: 'numeric'}) %> - 
                            <%= new Date(booking.checkout).toLocaleDateString("en-US", {month: 'short', day: 'numeric'}) %>
                        </div>
                        <div class="text-white-50" style="font-size: 11px;">Status: <span class="text-success text-opacity-75">Paid via <%= booking.payment %></span></div>
                    </td>
                    <td>
                        <div class="text-gold fw-bold">$<%= booking.listing ? booking.listing.price : 0 %></div>
                        <div class="text-white-50 small" style="font-size: 10px;">Platform ID: <%= booking._id.toString().slice(-4).toUpperCase() %></div>
                    </td>
                    <td class="text-end pe-4">
                        <a href="/admin/edit-booking/<%= booking._id %>" class="btn btn-outline-gold btn-sm px-3">
                            <i class="fas fa-pencil-alt me-1"></i> Override
                        </a>
                    </td>
                </tr>
            <% }) %>
            <% if (bookings.length === 0) { %>
                 <tr>
                    <td colspan="6" class="py-5 text-center text-white-50 italic">No bookings found in the system.</td>
                 </tr>
            <% } %>
        </tbody>
    </table>
</div>

<style>
    .stat-pill {
        background: rgba(255,255,255,0.03);
        border: 1px solid rgba(255,255,255,0.07);
        padding: 8px 25px;
        border-radius: 50px;
    }
    .btn-outline-gold {
         font-size: 11px;
         font-weight: 600;
         text-transform: uppercase;
         letter-spacing: 0.5px;
    }
</style>