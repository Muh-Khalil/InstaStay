<% layout("/layout/boilerplate.ejs")%>

    <!-- PAGE HERO -->
    <div class="page-hero">
        <div class="page-hero-bg"></div>
        <div class="page-hero-content">
            <div class="page-hero-tag">Our Story</div>
            <h1>About InstaStay</h1>
            <div class="breadcrumb">
                <a href="index.html">Home</a>
                <span>/</span>
                <span>About Us</span>
            </div>
        </div>
    </div>

    <!-- STORY -->
    <section class="story">
        <div class="story-grid">
            <div class="story-imgs ">
                <img class="story-img-main" src="https://images.unsplash.com/photo-1542314831-068cd1dbfeeb?w=900&q=80"
                    alt="Hotel exterior">
                <img class="story-img-sm" src="https://images.unsplash.com/photo-1631049307264-da0ec9d70304?w=500&q=80"
                    alt="Lobby">
                <img class="story-img-sm" src="https://images.unsplash.com/photo-1578683010236-d716f9a3f461?w=500&q=80"
                    alt="Pool">
                <div class="story-badge">
                    <div class="story-badge-num">1998</div>
                    <div class="story-badge-label">Founded</div>
                </div>
            </div>
            <div class="d-block">
                <div class="section-tag">Our Story</div>
                <h2 class="section-title">A Legacy Born from a Passion for Hospitality</h2>
                <p class="story-text"
                    style="font-size:15px; color:rgba(255,255,255,0.65); line-height:1.9; margin-bottom:18px;">InstaStay
                    was founded in 1998 with a single, unwavering vision: to create a sanctuary where luxury is not
                    merely a feature, but a feeling woven into every moment of every stay.</p>
                <p style="font-size:15px; color:rgba(255,255,255,0.65); line-height:1.9; margin-bottom:18px;">From a
                    single boutique property, we have grown into a celebrated landmark — expanding thoughtfully while
                    preserving the intimate elegance that has always defined us. Today, InstaStay stands as a testament
                    to what happens when architectural beauty meets heartfelt service.</p>
                <p style="font-size:15px; color:rgba(255,255,255,0.65); line-height:1.9; margin-bottom:32px;">Each room,
                    each corner, each dish is shaped by a deep respect for our guests' time, comfort, and expectations.
                    We do not simply host people — we welcome them into a world crafted entirely for them.</p>
                <div class="story-signature">
                    <img class="story-sig-img"
                        src="https://images.unsplash.com/photo-1472099645785-5658abf4ff4e?w=100&q=80" alt="CEO">
                    <div>
                        <div class="story-sig-name">Jonathan Sterling</div>
                        <div class="story-sig-role">Founder & CEO, InstaStay Hotels</div>
                    </div>
                </div>
            </div>
        </div>
    </section>

    <!-- NUMBERS -->
    <div class="numbers">
        <div class="numbers-grid">
            <div class="number-card ">
                <div class="number-val">250+</div>
                <div class="number-label">Luxury Rooms</div>
            </div>
            <div class="number-card">
                <div class="number-val">15K+</div>
                <div class="number-label">Happy Guests</div>
            </div>
            <div class="number-card">
                <div class="number-val">42</div>
                <div class="number-label">Awards Won</div>
            </div>
            <div class="number-card">
                <div class="number-val">98%</div>
                <div class="number-label">Satisfaction Rate</div>
            </div>
        </div>
    </div>

    <!-- PHILOSOPHY -->
    <section class="philosophy">
        <div class="phil-grid">
            <div class="">
                <img class="phil-img" src="https://images.unsplash.com/photo-1582719478250-c89cae4dc85b?w=800&q=80"
                    alt="Hotel interior">
            </div>
            <div class="d-block">
                <div class="section-tag">Our Philosophy</div>
                <h2 class="section-title">Guided by Values, Defined by Excellence</h2>
                <p class="phil-text"
                    style="font-size:15px; color:rgba(255,255,255,0.65); line-height:1.9; margin-bottom:8px;">At
                    InstaStay, every decision — from the thread count of our sheets to the temperature of our welcome —
                    is guided by four core values that have shaped us for over two decades.</p>
                <div class="phil-values">
                    <div class="phil-value">
                        <div class="phil-value-num">01</div>
                        <div>
                            <h4>Genuine Warmth</h4>
                            <p>Every guest is treated as a distinguished individual, not a room number.</p>
                        </div>
                    </div>
                    <div class="phil-value">
                        <div class="phil-value-num">02</div>
                        <div>
                            <h4>Uncompromising Quality</h4>
                            <p>We source only the finest materials, ingredients, and talent worldwide.</p>
                        </div>
                    </div>
                    <div class="phil-value">
                        <div class="phil-value-num">03</div>
                        <div>
                            <h4>Timeless Elegance</h4>
                            <p>Our design philosophy transcends trends — rooted in classic luxury.</p>
                        </div>
                    </div>
                    <div class="phil-value">
                        <div class="phil-value-num">04</div>
                        <div>
                            <h4>Responsible Luxury</h4>
                            <p>Sustainability and ethical operations are at the heart of how we operate.</p>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </section>

    <!-- TEAM -->
    <section class="team">
        <div class="team-head">
            <div>
                <div class="section-tag">The People Behind the Magic</div>
                <h2 class="section-title">Meet Our Leadership Team</h2>
            </div>
            <a href="#" class="btn-outline">Full Team</a>
        </div>
        <div class="team-grid">
            <div class="team-card ">
                <div class="team-img-wrap">
                    <img class="team-img" src="https://images.unsplash.com/photo-1472099645785-5658abf4ff4e?w=500&q=80"
                        alt="CEO">
                    <div class="team-overlay">
                        <div class="team-name">Jonathan Sterling</div>
                        <div class="team-role">Founder & CEO</div>
                        <div class="team-socials">
                            <a href="#" class="team-social-btn">in</a>
                            <a href="#" class="team-social-btn">𝕏</a>
                        </div>
                    </div>
                </div>
            </div>
            <div class="team-card">
                <div class="team-img-wrap">
                    <img class="team-img" src="https://images.unsplash.com/photo-1494790108377-be9c29b29330?w=500&q=80"
                        alt="GM">
                    <div class="team-overlay">
                        <div class="team-name">Isabelle Laurent</div>
                        <div class="team-role">General Manager</div>
                        <div class="team-socials">
                            <a href="#" class="team-social-btn">in</a>
                            <a href="#" class="team-social-btn">𝕏</a>
                        </div>
                    </div>
                </div>
            </div>
            <div class="team-card">
                <div class="team-img-wrap">
                    <img class="team-img" src="https://images.unsplash.com/photo-1500648767791-00dcc994a43e?w=500&q=80"
                        alt="Chef">
                    <div class="team-overlay">
                        <div class="team-name">Marco Fiore</div>
                        <div class="team-role">Executive Chef</div>
                        <div class="team-socials">
                            <a href="#" class="team-social-btn">in</a>
                            <a href="#" class="team-social-btn">📸</a>
                        </div>
                    </div>
                </div>
            </div>
            <div class="team-card">
                <div class="team-img-wrap">
                    <img class="team-img" src="https://images.unsplash.com/photo-1573496359142-b8d87734a5a2?w=500&q=80"
                        alt="Spa Director">
                    <div class="team-overlay">
                        <div class="team-name">Priya Mehta</div>
                        <div class="team-role">Spa & Wellness Director</div>
                        <div class="team-socials">
                            <a href="#" class="team-social-btn">in</a>
                            <a href="#" class="team-social-btn">📸</a>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </section>

    <!-- AWARDS -->
    <section class="awards">
        <div class="section-head "
            style="text-align:center; display:flex; flex-direction:column; align-items:center; margin-bottom:0;">
            <div class="section-tag" style="justify-content:center;"><span style="display:none"></span>Our Recognition
            </div>
            <h2 class="section-title">Awards & Accolades</h2>
            <p class="section-sub" style="text-align:center; margin:0 auto;">Our relentless pursuit of excellence has
                been recognized by the world's most prestigious hospitality institutions.</p>
        </div>
        <div class="awards-grid">
            <div class="award-card ">
                <div class="award-icon">🏆</div>
                <div>
                    <div class="award-year">2024</div>
                    <div class="award-name">Best Luxury Hotel — Asia Pacific</div>
                    <div class="award-body">World Travel Awards recognized InstaStay as the premier luxury destination
                        in the region for the third consecutive year.</div>
                </div>
            </div>
            <div class="award-card">
                <div class="award-icon">⭐</div>
                <div>
                    <div class="award-year">2023</div>
                    <div class="award-name">Five-Star Excellence Award</div>
                    <div class="award-body">Forbes Travel Guide awarded our property the coveted five-star rating,
                        acknowledging our exceptional guest experience.</div>
                </div>
            </div>
            <div class="award-card">
                <div class="award-icon">🍽️</div>
                <div>
                    <div class="award-year">2023</div>
                    <div class="award-name">Michelin Star — Fine Dining</div>
                    <div class="award-body">Our flagship restaurant earned its first Michelin star, led by Executive
                        Chef Marco Fiore and his celebrated tasting menu.</div>
                </div>
            </div>
            <div class="award-card ">
                <div class="award-icon">🌿</div>
                <div>
                    <div class="award-year">2022</div>
                    <div class="award-name">Green Key Gold Certification</div>
                    <div class="award-body">Recognized for our commitment to sustainable operations, energy efficiency,
                        and responsible tourism practices.</div>
                </div>
            </div>
            <div class="award-card">
                <div class="award-icon">💆</div>
                <div>
                    <div class="award-year">2022</div>
                    <div class="award-name">Best Spa — Condé Nast Traveler</div>
                    <div class="award-body">Readers of Condé Nast Traveler voted our InstaStay Spa as the best hotel spa
                        experience in the country.</div>
                </div>
            </div>
            <div class="award-card">
                <div class="award-icon">🎖️</div>
                <div>
                    <div class="award-year">2021</div>
                    <div class="award-name">TripAdvisor Travellers' Choice</div>
                    <div class="award-body">Ranked #1 in our city for six consecutive years based on thousands of
                        verified guest reviews.</div>
                </div>
            </div>
        </div>
    </section>

    <!-- PARTNERS -->
    <div class="partners">
        <h4>Trusted Partners & Affiliations</h4>
        <div class="partners-row">
            <span class="partner-logo">Leading Hotels</span>
            <span class="partner-logo">Forbes Travel</span>
            <span class="partner-logo">Condé Nast</span>
            <span class="partner-logo">World Travel Awards</span>
            <span class="partner-logo">Virtuoso</span>
            <span class="partner-logo">Michelin Guide</span>
        </div>
    </div>

    <!-- CTA BAR -->
    <div class="cta-bar">
        <div class="cta-bar-text">
            <h3>Ready to Experience the InstaStay Difference?</h3>
            <p>Reserve your stay today and step into a world of unmatched luxury and warmth.</p>
        </div>
        <div class="cta-bar-btns">
            <a href="/listings" class="btn-dark">Book Your Stay</a>
            <a href="/#contact" class="btn-ghost-dark">Contact Us</a>
        </div>
    </div>
