<% layout("/layout/boilerplate") %>

<style>
    .new-listing-wrap {
        margin-top: 70px;
        min-height: calc(100vh - 70px);
        background: var(--dark);
        display: flex;
        align-items: center;
        justify-content: center;
        padding: 40px 20px;
        position: relative;
        overflow: hidden;
    }

    .new-listing-bg {
        position: absolute;
        inset: 0;
        background: url('https://images.unsplash.com/photo-1571896349842-33c89424de2d?w=1600&q=80') center/cover no-repeat;
        opacity: 0.15;
        z-index: 0;
        filter: grayscale(100%) brightness(50%);
    }

    .creation-card {
        width: 100%;
        max-width: 900px;
        background: var(--dark2);
        border: 1px solid rgba(255, 255, 255, 0.07);
        border-radius: 20px;
        position: relative;
        z-index: 1;
        overflow: hidden;
        box-shadow: 0 40px 80px rgba(0, 0, 0, 0.8);
        display: flex;
    }

    .creation-sidebar {
        width: 320px;
        background: linear-gradient(180deg, var(--gold-dark) 0%, var(--dark2) 100%);
        padding: 60px 40px;
        display: flex;
        flex-direction: column;
        display: none;
    }

    @media (min-width: 992px) {
        .creation-sidebar { display: flex; }
    }

    .creation-content {
        flex-grow: 1;
        padding: 60px;
    }

    .step-indicator {
        display: flex;
        flex-direction: column;
        gap: 30px;
    }

    .step-item {
        display: flex;
        align-items: center;
        gap: 15px;
        opacity: 0.4;
        transition: all 0.3s;
    }
    .step-item.active { opacity: 1; }
    .step-num {
        width: 32px; height: 32px;
        border: 2px solid var(--white);
        border-radius: 50%;
        display: flex; align-items: center; justify-content: center;
        font-weight: bold; font-size: 14px;
    }
    .step-label { font-weight: 500; font-size: 15px; }

    .form-header h2 {
        font-family: var(--serif);
        font-size: 32px;
        color: var(--white);
        margin-bottom: 12px;
    }
    .form-header p { color: var(--muted); font-size: 14px; margin-bottom: 40px; }

    .luxury-input-group { margin-bottom: 25px; }
    .luxury-label {
        display: block;
        font-size: 11px;
        font-weight: 600;
        text-transform: uppercase;
        letter-spacing: 1.5px;
        color: var(--gold);
        margin-bottom: 12px;
    }
    .luxury-input {
        width: 100%;
        background: rgba(255, 255, 255, 0.03);
        border: 1px solid rgba(255, 255, 255, 0.1);
        border-radius: 8px;
        padding: 14px 18px;
        color: var(--white);
        font-family: var(--sans);
        font-size: 15px;
        outline: none;
        transition: all 0.3s;
    }
    .luxury-input:focus {
        border-color: var(--gold);
        background: rgba(201,168,76,0.05);
        box-shadow: 0 0 15px rgba(201,168,76,0.1);
    }
    .luxury-textarea { min-height: 120px; resize: none; }

    .submit-wrap { margin-top: 40px; }
    .btn-create {
        width: 100%;
        background: var(--gold);
        color: var(--dark);
        border: none;
        padding: 18px;
        border-radius: 8px;
        font-family: var(--sans);
        font-weight: 700;
        text-transform: uppercase;
        letter-spacing: 2px;
        transition: all 0.3s;
    }
    .btn-create:hover {
        background: var(--gold-light);
        transform: translateY(-2px);
        box-shadow: 0 10px 25px rgba(201,168,76,0.3);
    }

    .file-custom {
        padding: 12px;
        font-size: 13px;
    }
    .file-custom::-webkit-file-upload-button {
        background: var(--mid);
        border: none;
        color: var(--white);
        padding: 8px 16px;
        border-radius: 4px;
        margin-right: 15px;
        cursor: pointer;
    }
</style>

<div class="new-listing-wrap">
    <div class="new-listing-bg"></div>
    
    <div class="creation-card">
        <!-- Sidebar Navigation (Desktop) -->
        <div class="creation-sidebar">
            <h3 style="font-family: var(--serif); color: var(--white); margin-bottom: 50px;">Hotel Registration</h3>
            
            <div class="step-indicator">
                <div class="step-item active">
                    <div class="step-num">1</div>
                    <div class="step-label">Hotel Details</div>
                </div>
                <!-- ... -->
            </div>

            <div class="mt-auto">
                <p class="small text-white text-opacity-50">Need assistance? Contact our hotel hosting experts.</p>
            </div>
        </div>

        <!-- Form Content -->
        <div class="creation-content">
            <div class="form-header">
                <h2>List Your Hotel</h2>
                <p>Provide the essential details to begin attracting high-end clientele to your luxury accommodation.</p>
            </div>

            <form method="POST" action="/listings/new" novalidate class="needs-validation" enctype="multipart/form-data">
                
                <div class="luxury-input-group">
                    <label class="luxury-label">Hotel Title</label>
                    <input type="text" name="title" placeholder="e.g. InstaStay Horizon Suite" class="luxury-input" required>
                    <div class="invalid-feedback">A title is required to identify your hotel.</div>
                </div>

                <div class="luxury-input-group">
                    <label class="luxury-label">Description</label>
                    <textarea name="description" class="luxury-input luxury-textarea" placeholder="Tell your guests about the unique experiences your hotel offers..." required></textarea>
                    <div class="invalid-feedback">Please provide a compelling description.</div>
                </div>

                <div class="row">
                    <div class="col-md-6">
                        <div class="luxury-input-group">
                            <label class="luxury-label">Hotel Image</label>
                            <input type="file" name="image" class="luxury-input file-custom">
                        </div>
                    </div>
                    <div class="col-md-6">
                        <div class="luxury-input-group">
                            <label class="luxury-label">Nightly Rate (USD)</label>
                            <input type="number" name="price" placeholder="450" class="luxury-input" required>
                            <div class="invalid-feedback">Please specify a base price.</div>
                        </div>
                    </div>
                </div>

                <div class="row">
                    <div class="col-md-6">
                        <div class="luxury-input-group">
                            <label class="luxury-label">Country</label>
                            <input type="text" name="country" placeholder="Italy" class="luxury-input" required>
                        </div>
                    </div>
                    <div class="col-md-6">
                        <div class="luxury-input-group">
                            <label class="luxury-label">City / Location</label>
                            <input type="text" name="location" placeholder="Positano, Amalfi Coast" class="luxury-input" required>
                        </div>
                    </div>
                </div>

                <div class="submit-wrap">
                    <button class="btn-create">Publish Hotel Listing</button>
                    <p class="text-center mt-3 small text-white-50">By publishing, you agree to InstaStay's Hosting Terms.</p>
                </div>
            </form>
        </div>
    </div>
</div>