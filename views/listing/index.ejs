<% layout("/layout/boilerplate") %>

<div class="listing-page">
  <!-- FILTER BAR -->
  <div class="filter-bar">
    <div class="filter-item active"><i class="fa-solid fa-hotel"></i><span>All</span></div>
    <div class="filter-item"><i class="fa-solid fa-fire"></i><span>Trending</span></div>
    <div class="filter-item"><i class="fa-solid fa-mountain-sun"></i><span>Amazing Views</span></div>
    <div class="filter-item"><i class="fa-solid fa-person-swimming"></i><span>Pools</span></div>
    <div class="filter-item"><i class="fa-solid fa-tree-city"></i><span>Top Cities</span></div>
    <div class="filter-item"><i class="fa-solid fa-snowflake"></i><span>Snowfall</span></div>
    <div class="filter-item"><i class="fa-solid fa-umbrella-beach"></i><span>Beach</span></div>
    <div class="filter-item"><i class="fa-solid fa-sailboat"></i><span>Boats</span></div>
    <div class="filter-item"><i class="fa-solid fa-tractor"></i><span>Farms</span></div>
    <div class="filter-item"><i class="fa-solid fa-shield-dog"></i><span>Cabins</span></div>
    <div class="filter-item"><i class="fa-solid fa-bed"></i><span>Rooms</span></div>
  </div>

  <div class="prop-head">
    <h2>Explore Properties</h2>
  </div>

  <!-- PROPERTIES GRID -->
  <div class="prop-grid">
    <% for(listing of allListings) { %>
      <a href="/listings/<%=listing._id%>" class="prop-link">
        <div class="prop-card">
          <div class="prop-img-wrap">
            <img src="<%=listing.image.url%>" class="prop-img" alt="<%=listing.title%>">
            <div class="prop-badge">Premium</div>
          </div>
          <div class="prop-body">
            <div class="prop-title"><%= listing.title %></div>
            <div class="prop-loc">
              <i class="fa-solid fa-location-dot"></i> <%= listing.location || "Prime Location" %>
            </div>
            
            <div class="prop-footer">
              <div class="prop-price">
                <span class="prop-price-val">PKR <%= listing.price.toLocaleString("en-IN") %></span>
                <span class="prop-price-label">per night</span>
              </div>
              <div class="prop-action-icon">
                <i class="fa-solid fa-arrow-right"></i>
              </div>
            </div>
          </div>
        </div>
      </a>
    <% } %>
  </div>
</div>