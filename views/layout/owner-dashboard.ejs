<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Owner Dashboard | InstaStay</title>

    <!-- Google Fonts -->
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Playfair+Display:wght@400;500;600;700&family=DM+Sans:wght@400;500;700&display=swap"
        rel="stylesheet">

    <!-- Bootstrap CSS -->
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet">

    <!-- Font Awesome -->
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.6.0/css/all.min.css">

    <!-- Global Design System -->
    <style>
        :root {
            --gold: #C9A84C;
            --gold-light: #E8C97A;
            --gold-dark: #9A7A30;
            --dark: #0D0D0D;
            --dark2: #1A1A1A;
            --dark3: #252525;
            --mid: #3A3A3A;
            --muted: #888;
            --light: #F5F1EB;
            --white: #FFFFFF;
            --serif: 'Playfair Display', Georgia, serif;
            --sans: 'DM Sans', sans-serif;
            --glass: rgba(255, 255, 255, 0.03);
            --glass-border: rgba(255, 255, 255, 0.07);
        }

        body {
            font-family: var(--sans);
            background: var(--dark);
            color: var(--white);
            margin: 0;
            padding: 0;
            overflow-x: hidden;
            display: flex;
        }

        /* SIDEBAR Glass Refresh */
        .sidebar {
            width: 280px;
            background: var(--dark2) !important;
            border-right: 1px solid var(--glass-border);
            height: 100vh;
            position: sticky;
            top: 0;
            z-index: 1000;
            display: flex;
            flex-direction: column;
        }

        .menu-link {
            display: flex;
            align-items: center;
            gap: 14px;
            padding: 16px 28px;
            color: rgba(255,255,255,0.5);
            text-decoration: none !important;
            transition: all 0.4s cubic-bezier(0.165, 0.84, 0.44, 1);
            font-size: 14px;
            font-weight: 500;
            letter-spacing: 0.5px;
        }

        .menu-link:hover, .menu-link.active {
            color: var(--gold);
            background: rgba(201,168,76,0.06);
        }
        
        .menu-link.active {
            border-right: 3px solid var(--gold);
            color: var(--white);
        }

        .menu-link i {
            font-size: 20px;
            width: 24px;
            transition: transform 0.3s;
        }
        .menu-link:hover i { transform: scale(1.1); }

        #page-content {
            flex-grow: 1;
            background: #080808;
            min-height: 100vh;
            padding: 40px 60px;
            color: var(--white);
        }

        /* PREMIUM CARDS */
        .dashboard-card {
            background: var(--dark2);
            border: 1px solid var(--glass-border);
            border-radius: 16px;
            padding: 30px;
            height: 100%;
            transition: all 0.4s ease;
            position: relative;
            overflow: hidden;
            color: var(--white);
        }
        .dashboard-card::before {
            content: '';
            position: absolute; top: 0; left: 0; width: 100%; height: 100%;
            background: radial-gradient(circle at top left, rgba(201,168,76,0.05), transparent 60%);
            pointer-events: none;
        }
        .dashboard-card:hover {
            transform: translateY(-8px);
            border-color: rgba(201,168,76,0.3);
            box-shadow: 0 20px 40px rgba(0,0,0,0.5);
        }

        .card-icon {
            width: 60px; height: 60px;
            border-radius: 12px;
            display: flex; align-items: center; justify-content: center;
            font-size: 24px; margin-bottom: 25px;
            background: rgba(255,255,255,0.05);
            border: 1px solid var(--glass-border);
        }

        .text-gold { color: var(--gold) !important; }
        .text-muted { color: rgba(255,255,255,0.5) !important; }

        .btn-outline-gold {
            border: 1px solid var(--gold);
            color: var(--gold);
            font-family: var(--sans);
            font-weight: 600;
            text-transform: uppercase;
            letter-spacing: 1.5px;
            font-size: 11px;
            padding: 12px 24px;
            transition: all 0.3s;
        }
        .btn-outline-gold:hover {
            background: var(--gold);
            color: var(--dark);
            transform: translateY(-2px);
        }

        /* TABLE CUSTOMIZATION */
        .table-premium {
            background: var(--dark2) !important;
            border: 1px solid var(--glass-border);
            border-radius: 12px;
            overflow: hidden;
        }
        .table-premium th {
            background: rgba(255,255,255,0.02) !important;
            color: rgba(255,255,255,0.6) !important;
            font-size: 11px;
            text-transform: uppercase;
            letter-spacing: 1px;
            padding: 20px !important;
            border-bottom: 1px solid var(--glass-border) !important;
        }
        .table-premium td {
            padding: 20px !important;
            vertical-align: middle;
            color: var(--white);
            border-bottom: 1px solid rgba(255,255,255,0.03) !important;
        }
    </style>
</head>

<body>
    <%- include("../includes/OwnerSidebar.ejs") %>
    
    <%- include("../includes/flash.ejs") %>

    <!-- Global Loading Overlay -->
    <div id="loading-overlay" class="loading-overlay" style="display: none;">
        <div class="luxury-spinner-container">
            <div class="luxury-spinner"></div>
            <div class="loading-text">Updating Master Registry...</div>
        </div>
    </div>

    <style>
        .loading-overlay {
            position: fixed; top: 0; left: 0; width: 100%; height: 100%;
            background: rgba(8, 8, 8, 0.85); backdrop-filter: blur(12px);
            z-index: 99999; display: flex; align-items: center; justify-content: center;
        }
        .luxury-spinner-container { text-align: center; }
        .luxury-spinner {
            width: 70px; height: 70px;
            border: 2px solid rgba(201, 168, 76, 0.1);
            border-top: 2px solid var(--gold);
            border-radius: 50%;
            animation: luxury-spin 1.2s cubic-bezier(0.5, 0, 0.5, 1) infinite;
            margin-bottom: 25px;
        }
        .loading-text {
            font-family: var(--serif);
            color: var(--gold);
            text-transform: uppercase;
            letter-spacing: 4px;
            font-size: 13px;
        }
        @keyframes luxury-spin { 0% { transform: rotate(0deg); } 100% { transform: rotate(360deg); } }
    </style>

    <!-- Bootstrap Bundle JS -->
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/js/bootstrap.bundle.min.js"></script>

    <script>
        // Sidebar toggle logic
        const sidebar = document.getElementById('sidebar');
        const toggleBtn = document.getElementById('toggle-sidebar');
        const closeBtn = document.getElementById('close-sidebar');

        if(toggleBtn) {
            toggleBtn.addEventListener('click', () => {
                sidebar.classList.toggle('d-none');
            });
        }
        if(closeBtn) {
            closeBtn.addEventListener('click', () => {
                sidebar.classList.add('d-none');
            });
        }

        // Loader Logic
        window.addEventListener('load', () => {
            const forms = document.querySelectorAll('form');
            const loader = document.getElementById('loading-overlay');
            forms.forEach(f => {
                f.addEventListener('submit', () => {
                    if(f.checkValidity()) loader.style.display = 'flex';
                });
            });
        });
    </script>
</body>
</html>
