<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Platform Command | InstaStay Admin</title>

    <!-- Google Fonts -->
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Playfair+Display:wght@400;500;600;700&family=DM+Sans:wght@400;500;700&display=swap"
        rel="stylesheet">

    <!-- Bootstrap CSS -->
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet">

    <!-- Font Awesome -->
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.6.0/css/all.min.css">

    <!-- Global Design System -->
    <style>
        :root {
            --gold: #C9A84C;
            --gold-light: #E8C97A;
            --gold-dark: #9A7A30;
            --dark: #0D0D0D;
            --dark2: #151515;
            --glass: rgba(255, 255, 255, 0.03);
            --glass-border: rgba(255, 255, 255, 0.07);
            --serif: 'Playfair Display', Georgia, serif;
            --sans: 'DM Sans', sans-serif;
        }

        body {
            font-family: var(--sans);
            background: var(--dark);
            color: #FFFFFF;
            margin: 0;
            padding: 0;
            overflow: hidden; 
        }

        .d-flex {
            display: flex !important;
        }

        /* SIDEBAR STYLES */
        .sidebar {
            width: 280px;
            background: var(--dark2) !important;
            border-right: 1px solid var(--glass-border);
            height: 100vh;
            position: sticky;
            top: 0;
            z-index: 1100;
            display: flex;
            flex-direction: column;
            transition: all 0.3s cubic-bezier(0.4, 0, 0.2, 1);
        }

        .menu-link {
            display: flex;
            align-items: center;
            gap: 15px;
            padding: 14px 25px;
            color: rgba(255,255,255,0.5);
            text-decoration: none !important;
            transition: all 0.3s ease;
            font-size: 14px;
            font-weight: 500;
            border-radius: 8px;
            margin: 4px 12px;
        }

        .menu-link:hover, .menu-link.active {
            color: var(--gold);
            background: rgba(201,168,76,0.08);
        }
        
        .menu-link.active {
            color: var(--white);
            background: rgba(201,168,76,0.12);
            border-left: 3px solid var(--gold);
            border-radius: 0 8px 8px 0;
            margin-left: 0;
        }

        .menu-link i {
            font-size: 18px;
            width: 24px;
            text-align: center;
        }

        #page-content {
            background: #0A0A0A;
            height: 100vh;
            flex-grow: 1;
            overflow-y: auto;
        }

        .dashboard-wrapper {
            padding: 40px 50px;
            max-width: 1600px;
            margin: 0 auto;
        }

        /* PREMIUM UI COMPONENTS */
        .stat-card {
            background: var(--dark2);
            border: 1px solid var(--glass-border);
            border-radius: 20px;
            padding: 30px;
            height: 100%;
            transition: transform 0.4s cubic-bezier(0.175, 0.885, 0.32, 1.275), border-color 0.3s;
        }
        .stat-card:hover {
            transform: translateY(-10px);
            border-color: var(--gold);
        }

        .icon-box {
            width: 54px; height: 54px;
            border-radius: 12px;
            display: flex; align-items: center; justify-content: center;
            font-size: 22px; margin-bottom: 20px;
            background: rgba(255,255,255,0.03);
            border: 1px solid var(--glass-border);
        }

        .btn-outline-gold {
            border: 1px solid var(--gold);
            color: var(--gold);
            text-transform: uppercase;
            letter-spacing: 1px;
            font-size: 12px;
            font-weight: 600;
            padding: 10px 20px;
            transition: all 0.3s;
        }
        .btn-outline-gold:hover {
            background: var(--gold);
            color: var(--dark);
        }

        /* Responsive Sidebar */
        @media (max-width: 991px) {
            .sidebar {
                position: fixed;
                left: -280px;
            }
            .sidebar.show {
                left: 0;
            }
            .dashboard-wrapper {
                padding: 30px 20px;
            }
        }

        .table-premium {
            background: var(--dark2);
            border-radius: 15px;
            border: 1px solid var(--glass-border);
            overflow: hidden;
        }
        .table-premium th {
            background: rgba(255,255,255,0.02);
            color: rgba(255,255,255,0.5);
            text-transform: uppercase;
            font-size: 11px;
            letter-spacing: 1px;
            padding: 20px;
            border-bottom: 1px solid var(--glass-border);
        }
        .table-premium td {
            color: #FFFFFF;
            padding: 20px;
            border-bottom: 1px solid rgba(255,255,255,0.03);
        }
    </style>
</head>

<body>
    <div class="d-flex">
        <%- include("../includes/Sidebar.ejs") %>

        <div id="page-content">
            <header class="navbar navbar-dark bg-dark px-4 py-3 border-bottom border-secondary border-opacity-25 d-md-none sticky-top">
                <button id="toggle-sidebar" class="btn btn-outline-gold btn-sm"><i class="fas fa-bars"></i></button>
                <span class="navbar-brand mb-0 h1" style="font-family: var(--serif);">InstaStay Admin</span>
            </header>
            
            <%- include("../includes/flash.ejs") %>
            
            <div class="dashboard-wrapper">
                <%- body %>
            </div>
        </div>
    </div>

    <!-- Global Loading Overlay -->
    <div id="loading-overlay" class="loading-overlay" style="display: none;">
        <div class="luxury-spinner-container">
            <div class="luxury-spinner"></div>
            <div class="loading-text">Synchronizing Global Data...</div>
        </div>
    </div>

    <style>
        .loading-overlay {
            position: fixed; top: 0; left: 0; width: 100%; height: 100%;
            background: rgba(8, 8, 8, 0.9); backdrop-filter: blur(15px);
            z-index: 99999; display: flex; align-items: center; justify-content: center;
        }
        .luxury-spinner {
            width: 80px; height: 80px;
            border: 2px solid rgba(201, 168, 76, 0.1);
            border-top: 2px solid var(--gold);
            border-radius: 50%;
            animation: luxury-spin 1s cubic-bezier(0.4, 0, 0.2, 1) infinite;
            margin: 0 auto 30px;
        }
        .loading-text {
            font-family: var(--serif);
            color: var(--gold);
            text-transform: uppercase;
            letter-spacing: 5px;
            font-size: 12px;
            text-align: center;
        }
        @keyframes luxury-spin { 0% { transform: rotate(0deg); } 100% { transform: rotate(360deg); } }
    </style>

    <!-- Bootstrap Bundle JS -->
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/js/bootstrap.bundle.min.js"></script>

    <script>
        const sidebar = document.getElementById('sidebar');
        const toggleBtn = document.getElementById('toggle-sidebar');
        const closeBtn = document.getElementById('close-sidebar');

        if(toggleBtn) {
            toggleBtn.addEventListener('click', () => {
                sidebar.classList.toggle('show');
            });
        }
        if(closeBtn) {
            closeBtn.addEventListener('click', () => {
                sidebar.classList.remove('show');
            });
        }

        // Global Admin Loader
        window.addEventListener('load', () => {
            const forms = document.querySelectorAll('form');
            const loader = document.getElementById('loading-overlay');
            forms.forEach(f => {
                f.addEventListener('submit', () => {
                    if(f.checkValidity()) loader.style.display = 'flex';
                });
            });
        });
    </script>
</body>
</html>
